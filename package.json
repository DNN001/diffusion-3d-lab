{
  "name": "@local/diffusion-3d-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive 3D lab for DDPM: follow one image through the forward noising chain, the U-Net and the reverse denoising chain.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
